{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "name",
          "rationale",
          "confidence",
          "agent_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "common_rule",
              "agent_overlay",
              "skill",
              "manual_memory",
              "session_context",
              "native_setting",
              "unsupported",
              "sensitive_skip",
              "conflict"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "rationale": {
            "type": "string",
            "maxLength": 500
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "agent_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
