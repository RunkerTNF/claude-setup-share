{
  "schema_version": 1,
  "id": "claude",
  "display_name": "Claude Code",
  "executables": [
    "claude"
  ],
  "version_args": [
    "--version"
  ],
  "supported_versions": [],
  "global": {
    "discovery_paths": [
      ".claude/CLAUDE.md"
    ],
    "instruction_entrypoints": [
      {
        "target": ".claude/CLAUDE.md",
        "template": "templates/global-claude.md",
        "profiles": []
      }
    ],
    "skill_locations": [
      {
        "path": ".claude/skills",
        "mode": "wrapper"
      }
    ],
    "inventory_roots": [
      {
        "path": ".claude/CLAUDE.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".claude/agents",
        "kind": "subagent_prompt",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".claude/commands",
        "kind": "command",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".claude/projects",
        "kind": "auto_memory",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".claude/settings.json",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".claude/settings.local.json",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".claude/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      }
    ]
  },
  "project": {
    "discovery_paths": [
      "CLAUDE.local.md",
      "CLAUDE.md"
    ],
    "instruction_entrypoints": [
      {
        "target": "CLAUDE.local.md",
        "template": "templates/project-claude-local.md",
        "profiles": [
          "local"
        ]
      },
      {
        "target": "CLAUDE.md",
        "template": "templates/project-claude.md",
        "profiles": [
          "shared",
          "split"
        ]
      }
    ],
    "skill_locations": [
      {
        "path": ".claude/skills",
        "mode": "wrapper"
      }
    ],
    "inventory_roots": [
      {
        "path": ".claude/agents",
        "kind": "subagent_prompt",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".claude/commands",
        "kind": "command",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".claude/settings.json",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".claude/settings.local.json",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".claude/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      },
      {
        "path": "CLAUDE.local.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": "CLAUDE.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      }
    ]
  },
  "capabilities": {
    "commands": "supported",
    "hooks": "supported",
    "mcp": "supported",
    "permissions": "supported",
    "rules": "supported",
    "skills": "supported",
    "subagents": "supported"
  },
  "sensitive_keys": [
    "api_key",
    "auth_token",
    "http_headers"
  ],
  "validation": [],
  "smoke": [
    "Open a fresh Claude Code session.",
    "Verify imported rules and native skill wrappers are available."
  ]
}
