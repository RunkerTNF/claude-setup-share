{
  "schema_version": 1,
  "id": "codex",
  "display_name": "Codex",
  "executables": [
    "codex"
  ],
  "version_args": [
    "--version"
  ],
  "supported_versions": [],
  "global": {
    "discovery_paths": [
      ".codex/AGENTS.md"
    ],
    "instruction_entrypoints": [
      {
        "target": ".codex/AGENTS.md",
        "template": "templates/global-agents.md",
        "profiles": []
      }
    ],
    "skill_locations": [
      {
        "path": ".agents/skills",
        "mode": "direct"
      }
    ],
    "inventory_roots": [
      {
        "path": ".agents/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      },
      {
        "path": ".codex/AGENTS.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".codex/config.toml",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".codex/memory",
        "kind": "manual_memory",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".codex/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      }
    ]
  },
  "project": {
    "discovery_paths": [
      "AGENTS.md",
      "AGENTS.override.md"
    ],
    "instruction_entrypoints": [
      {
        "target": "AGENTS.override.md",
        "template": "templates/project-agents-override.md",
        "profiles": [
          "local"
        ]
      },
      {
        "target": "AGENTS.md",
        "template": "templates/project-agents.md",
        "profiles": [
          "shared",
          "split"
        ]
      }
    ],
    "skill_locations": [
      {
        "path": ".agents/skills",
        "mode": "direct"
      }
    ],
    "inventory_roots": [
      {
        "path": ".agents/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      },
      {
        "path": ".codex/config.toml",
        "kind": "settings",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": ".codex/memory",
        "kind": "manual_memory",
        "recursive": true,
        "include_globs": [
          "*.md",
          "**/*.md"
        ]
      },
      {
        "path": ".codex/skills",
        "kind": "skill",
        "recursive": true,
        "include_globs": [
          "**/*"
        ]
      },
      {
        "path": "AGENTS.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      },
      {
        "path": "AGENTS.override.md",
        "kind": "rules",
        "recursive": false,
        "include_globs": []
      }
    ]
  },
  "capabilities": {
    "commands": "partial",
    "hooks": "supported",
    "mcp": "supported",
    "permissions": "supported",
    "rules": "supported",
    "skills": "supported",
    "subagents": "partial"
  },
  "sensitive_keys": [
    "api_key",
    "bearer_token",
    "http_headers"
  ],
  "validation": [],
  "smoke": [
    "Open a fresh Codex session.",
    "Verify common rules and canonical skills are available."
  ]
}
